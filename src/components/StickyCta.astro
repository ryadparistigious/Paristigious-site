---
import { whatsappHref, site } from '../lib/site';

interface Props {
  /** Prestation préremplie dans le formulaire au clic. (règle 17) */
  need?: string;
  /** Contexte injecté dans le message WhatsApp. (règle 18) */
  context?: string;
}

const { need, context } = Astro.props;
const href = need ? `/demande-de-devis?besoin=${need}` : '/demande-de-devis';
const wa = whatsappHref(context);
---

{/* Ancre posée juste sous le premier écran : tant qu'elle est visible, le
    visiteur est encore dans le hero et la barre reste hors champ. */}
<div class="sticky-cta__anchor" data-sticky-cta-anchor aria-hidden="true"></div>

{/* Barre visible uniquement sur petits écrans, uniquement après le hero,
    et masquée dès que le CTA de devis est lui-même à l'écran. (règle 23) */}
<div class="sticky-cta" data-sticky-cta>
  <a class="sticky-cta__main" href={href}>
    Demander un devis
    <span aria-hidden="true">→</span>
  </a>
  {
    wa ? (
      <a class="sticky-cta__alt" href={wa} target="_blank" rel="noopener" aria-label="Écrire sur WhatsApp">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.8 14.13c-.24.68-1.42 1.31-1.95 1.36-.5.05-.96.23-3.24-.68-2.72-1.08-4.44-3.85-4.58-4.03-.13-.18-1.09-1.45-1.09-2.77s.69-1.97.94-2.24c.24-.27.53-.34.71-.34.18 0 .35 0 .51.01.16.01.38-.06.6.46.23.55.77 1.89.84 2.03.07.14.11.3.02.48-.09.18-.14.3-.27.46-.14.16-.29.36-.41.48-.14.14-.28.29-.12.56.16.27.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.27.14.43.11.59-.07.16-.18.68-.79.86-1.07.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.14.45.2.52.32.07.11.07.64-.17 1.32z" />
        </svg>
      </a>
    ) : (
      <a class="sticky-cta__alt" href={`mailto:${site.email}`} aria-label="Écrire par email">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="2.5" y="5" width="19" height="14" rx="2" />
          <path d="M3 6.5l9 6 9-6" />
        </svg>
      </a>
    )
  }
</div>

<style lang="scss">
  /* Même principe que l'ancre du bouton « retour en haut » : une bande
     partant du sommet, pour que la sortie du viewport soit un vrai
     franchissement observable. */
  .sticky-cta__anchor {
    position: absolute;
    inset-block-start: 0;
    inline-size: 1px;
    block-size: 85svh;
    pointer-events: none;
  }

  .sticky-cta {
    position: fixed;
    inset-inline: 0.75rem;
    inset-block-end: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    z-index: 80;
    display: flex;
    gap: 0.5rem;
    view-transition-name: sticky-cta;

    /* Hors écran et non focalisable tant que la barre n'est pas activée :
       le clavier ne tombe jamais sur un élément invisible. */
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 120%, 0);
    transition:
      opacity var(--t-base) var(--ease),
      transform var(--t-slow) var(--ease-out),
      visibility 0s linear var(--t-slow);
  }

  .sticky-cta.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s, 0s, 0s;
  }

  /* Desktop : le header porte déjà le CTA en permanence, la barre ferait
     doublon et mangerait de l'espace de lecture. */
  @include from($bp-md) {
    .sticky-cta {
      display: none;
    }
  }

  /* Sans JavaScript la barre ne peut pas se piloter : on la masque plutôt
     que de la laisser recouvrir le contenu en permanence. */
  :global(html:not(.js)) .sticky-cta {
    display: none;
  }

  .sticky-cta__main {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-block-size: 3.25rem;
    padding-inline: 1.25rem;
    background: var(--brass-500);
    color: var(--navy-950);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .sticky-cta__alt {
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    flex: none;
    background: var(--navy-900);
    color: var(--ivory-100);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
  }

  .sticky-cta__main:active,
  .sticky-cta__alt:active {
    transform: translate3d(0, 1px, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta {
      transition-duration: 1ms, 1ms, 0s;
    }
  }
</style>
